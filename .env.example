# 1) Créez un compte de service Google Cloud avec l'API Google Sheets activée
# 2) Partagez votre Google Sheet avec l'email du compte de service (rôle Éditeur)
# 3) Renseignez les valeurs ci-dessous dans .env.local (développement) et dans
#    les variables d'environnement du projet sur Vercel (production)

GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# سر توقيع جلسات الدخول — نص عشوائي طويل (ولّده بالأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=""
